# This is an example file. Please create a .env file in the root directory
# and add your secrets and configuration.
# DO NOT commit the .env file to your repository.

# --- OpenAI API ---
OPENAI_API_KEY="your_openai_api_key_here"

# --- PostgreSQL Database Connection ---
# These should match the values in docker-compose.yml
DB_USER="user"
DB_PASSWORD="password"
DB_HOST="localhost" # Use "localhost" when running the script directly on your machine
DB_PORT="5432"
DB_NAME="reviews_db"
